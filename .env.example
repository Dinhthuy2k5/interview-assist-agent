# Database
DATABASE_URL=postgresql://iaa_user:changeme@localhost:5432/interview_assist_agent

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=iaa-files

# LLM
ANTHROPIC_API_KEY=
LLM_MOCK_MODE=true
# Groq model name - thay đổi tại đây, không cần sửa code
GROQ_MODEL=llama-3.3-70b-versatile

# Auth
JWT_SECRET=changeme
JWT_EXPIRE_MINUTES=60

# App
ENV=development

# CORS - danh sách origin được phép gọi API, phân cách bằng dấu phẩy
# Dev: ALLOWED_ORIGINS=http://localhost:5173
# Production: ALLOWED_ORIGINS=https://ngdinhthuy.duckdns.org
ALLOWED_ORIGINS=http://localhost:5173

# Vite dev server - set domain production để dev server trên VPS chấp nhận request
# Chỉ cần thiết khi chạy "npm run dev" trên VPS, không ảnh hưởng production build
# VITE_ALLOWED_HOST=ngdinhthuy.duckdns.org