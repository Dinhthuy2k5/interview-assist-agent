# Dockerfile.prod - Build production-grade frontend image dùng Nginx
#
# Khác biệt so với Dockerfile (dev):
#   - Stage 1 (builder): cài deps + chạy "npm run build" → tạo thư mục dist/
#   - Stage 2 (runner): copy dist/ vào Nginx image siêu nhẹ (~40MB so với ~250MB node:20-slim)
#     Nginx phục vụ static files - không cần Vite dev server chạy liên tục,
#     tiết kiệm đáng kể RAM trên VPS 1GB Oracle Cloud.
#
# Cách build & dùng:
#   Tự động khi dùng docker-compose.prod.yml (override build.dockerfile)
#   Manual: docker build -f Dockerfile.prod -t iaa-frontend-prod .

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-slim AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --frozen-lockfile

COPY . .

RUN npm run build
# Kết quả: /app/dist/

# ── Stage 2: Serve với Nginx ──────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Xoá config mặc định của Nginx, thay bằng config SPA-aware
RUN rm /etc/nginx/conf.d/default.conf

COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy static files từ stage builder
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
